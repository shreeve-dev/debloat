    {
      "id": "power.faststartup",
      "name": "Fast startup",
      "category": "Power",
      "description": "Shut down into a light hibernate so the PC starts faster. Off is better for dual-boot and for driver updates that need a clean start.",
      "options": [
        {
          "label": "On",
          "registry": [
            {
              "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power",
              "name": "HiberbootEnabled",
              "type": "DWord",
              "value": 1,
              "defaultMatches": true
            }
          ]
        },
        {
          "label": "Off",
          "registry": [
            {
              "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power",
              "name": "HiberbootEnabled",
              "type": "DWord",
              "value": 0
            }
          ]
        }
      ]
    },
    {
      "id": "power.hibernate",
      "name": "Hibernation",
      "category": "Power",
      "description": "Off deletes hiberfil.sys, which frees several GB, and also turns off Fast startup.",
      "options": [
        {
          "label": "On",
          "script": {
            "describe": "powercfg /hibernate on",
            "snapshot": "[string](Get-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Power' -Name HibernateEnabled -ErrorAction SilentlyContinue).HibernateEnabled",
            "apply": "powercfg /hibernate on",
            "undo": "if ($Snapshot -eq '0') { powercfg /hibernate off }",
            "detect": "(Get-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Power' -Name HibernateEnabled -ErrorAction SilentlyContinue).HibernateEnabled -eq 1"
          }
        },
        {
          "label": "Off",
          "script": {
            "describe": "powercfg /hibernate off",
            "snapshot": "[string](Get-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Power' -Name HibernateEnabled -ErrorAction SilentlyContinue).HibernateEnabled",
            "apply": "powercfg /hibernate off",
            "undo": "if ($Snapshot -eq '1') { powercfg /hibernate on }",
            "detect": "(Get-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Power' -Name HibernateEnabled -ErrorAction SilentlyContinue).HibernateEnabled -eq 0"
          }
        }
      ]
    },
    {
      "id": "gaming.gamemode",
      "name": "Game Mode",
      "category": "Gaming",
      "description": "Windows gives the game you're playing priority and holds back updates while you play.",
      "options": [
        {
          "label": "On",
          "registry": [
            {
              "path": "HKCU\\Software\\Microsoft\\GameBar",
              "name": "AutoGameModeEnabled",
              "type": "DWord",
              "value": 1,
              "defaultMatches": true
            }
          ]
        },
        {
          "label": "Off",
          "registry": [
            {
              "path": "HKCU\\Software\\Microsoft\\GameBar",
              "name": "AutoGameModeEnabled",
              "type": "DWord",
              "value": 0
            }
          ]
        }
      ]
    },
    {
      "id": "gaming.hags",
      "name": "Hardware-accelerated GPU scheduling",
      "category": "Gaming",
      "description": "Lets the graphics card manage its own memory. Needed for DLSS frame generation. Takes effect after a restart.",
      "options": [
        {
          "label": "On",
          "registry": [
            {
              "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
              "name": "HwSchMode",
              "type": "DWord",
              "value": 2
            }
          ]
        },
        {
          "label": "Off",
          "registry": [
            {
              "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers",
              "name": "HwSchMode",
              "type": "DWord",
              "value": 1
            }
          ]
        }
      ],
      "after": [
        "reboot"
      ]
    },
    {
      "id": "gaming.gamedvr",
      "name": "Record games in the background",
      "category": "Gaming",
      "description": "Xbox Game Bar keeps the last few minutes of gameplay. Costs a little performance.",
      "options": [
        {
          "label": "On",
          "registry": [
            {
              "path": "HKCU\\System\\GameConfigStore",
              "name": "GameDVR_Enabled",
              "type": "DWord",
              "value": 1,
              "defaultMatches": true
            }
          ]
        },
        {
          "label": "Off",
          "registry": [
            {
              "path": "HKCU\\System\\GameConfigStore",
              "name": "GameDVR_Enabled",
              "type": "DWord",
              "value": 0
            }
          ]
        }
      ]
    },
    {
      "id": "security.uacdim",
      "name": "Dim the screen for admin prompts",
      "category": "Security & remote access",
      "description": "The secure desktop stops other programs from clicking Yes for you. Turning it off keeps the prompt but skips the dimming.",
      "options": [
        {
          "label": "On (recommended)",
          "registry": [
            {
              "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
              "name": "PromptOnSecureDesktop",
              "type": "DWord",
              "value": 1,
              "defaultMatches": true
            }
          ]
        },
        {
          "label": "Off",
          "registry": [
            {
              "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
              "name": "PromptOnSecureDesktop",
              "type": "DWord",
              "value": 0
            }
          ]
        }
      ]
    },
    {
      "id": "security.rdp",
      "name": "Remote Desktop",
      "category": "Security & remote access",
      "description": "Lets other PCs connect to this one with Remote Desktop and opens it in the firewall. Windows Pro and up only.",
      "options": [
        {
          "label": "On",
          "registry": [
            {
              "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server",
              "name": "fDenyTSConnections",
              "type": "DWord",
              "value": 0
            }
          ],
          "script": {
            "describe": "Allow Remote Desktop through the firewall",
            "snapshot": "[string]([bool](Get-NetFirewallRule -Group '@FirewallAPI.dll,-28752' -ErrorAction SilentlyContinue | Where-Object { $_.Enabled -eq 'True' }))",
            "apply": "Enable-NetFirewallRule -Group '@FirewallAPI.dll,-28752'",
            "undo": "if ($Snapshot -ne 'True') { Disable-NetFirewallRule -Group '@FirewallAPI.dll,-28752' }",
            "detect": "[string]([bool](Get-NetFirewallRule -Group '@FirewallAPI.dll,-28752' -ErrorAction SilentlyContinue | Where-Object { $_.Enabled -eq 'True' })) -eq 'True'"
          }
        },
        {
          "label": "Off",
          "registry": [
            {
              "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server",
              "name": "fDenyTSConnections",
              "type": "DWord",
              "value": 1,
              "defaultMatches": true
            }
          ],
          "script": {
            "describe": "Close Remote Desktop in the firewall",
            "snapshot": "[string]([bool](Get-NetFirewallRule -Group '@FirewallAPI.dll,-28752' -ErrorAction SilentlyContinue | Where-Object { $_.Enabled -eq 'True' }))",
            "apply": "Disable-NetFirewallRule -Group '@FirewallAPI.dll,-28752'",
            "undo": "if ($Snapshot -eq 'True') { Enable-NetFirewallRule -Group '@FirewallAPI.dll,-28752' }",
            "detect": "[string]([bool](Get-NetFirewallRule -Group '@FirewallAPI.dll,-28752' -ErrorAction SilentlyContinue | Where-Object { $_.Enabled -eq 'True' })) -eq 'False'"
          }
        }
      ]
    }
  ]
}
