    {
      "id": "power.plan",
      "name": "Power plan",
      "category": "Power",
      "description": "Balanced suits most PCs. High performance keeps the CPU at full speed and uses more power.",
      "options": [
        {
          "label": "Balanced",
          "script": {
            "describe": "Switch to the Balanced power plan",
            "snapshot": "[regex]::Match([string](powercfg /getactivescheme), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}').Value",
            "apply": [
              "powercfg /setactive 381b4222-f694-41f0-9685-ff5bb260df2e",
              "if ($LASTEXITCODE) { throw 'This PC does not have the Balanced plan.' }"
            ],
            "undo": "if ($Snapshot) { powercfg /setactive $Snapshot | Out-Null }",
            "detect": "[string](powercfg /getactivescheme) -match '381b4222-f694-41f0-9685-ff5bb260df2e'"
          }
        },
        {
          "label": "High performance",
          "script": {
            "describe": "Switch to the High performance power plan",
            "snapshot": "[regex]::Match([string](powercfg /getactivescheme), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}').Value",
            "apply": [
              "powercfg /setactive 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c",
              "if ($LASTEXITCODE) { throw 'This PC does not have the High performance plan.' }"
            ],
            "undo": "if ($Snapshot) { powercfg /setactive $Snapshot | Out-Null }",
            "detect": "[string](powercfg /getactivescheme) -match '8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c'"
          }
        },
        {
          "label": "Power saver",
          "script": {
            "describe": "Switch to the Power saver power plan",
            "snapshot": "[regex]::Match([string](powercfg /getactivescheme), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}').Value",
            "apply": [
              "powercfg /setactive a1841308-3541-4fab-bc81-f71556f20b4a",
              "if ($LASTEXITCODE) { throw 'This PC does not have the Power saver plan.' }"
            ],
            "undo": "if ($Snapshot) { powercfg /setactive $Snapshot | Out-Null }",
            "detect": "[string](powercfg /getactivescheme) -match 'a1841308-3541-4fab-bc81-f71556f20b4a'"
          }
        }
      ]
    },
    {
      "id": "power.screenoff",
      "name": "Turn off the screen after",
      "category": "Power",
      "description": "When plugged in. Applies to the current power plan.",
      "options": [
        {
          "label": "Never",
          "script": {
            "describe": "powercfg SUB_VIDEO VIDEOIDLE (plugged in) = 0 s",
            "snapshot": [
              "$h = [regex]::Matches([string](powercfg /query SCHEME_CURRENT SUB_VIDEO VIDEOIDLE), '0x[0-9a-fA-F]{8}')",
              "if ($h.Count -ge 2) { [string][Convert]::ToUInt32($h[$h.Count - 2].Value, 16) }"
            ],
            "apply": [
              "powercfg /setacvalueindex SCHEME_CURRENT SUB_VIDEO VIDEOIDLE 0",
              "powercfg /setactive SCHEME_CURRENT"
            ],
            "undo": [
              "if ($Snapshot) { powercfg /setacvalueindex SCHEME_CURRENT SUB_VIDEO VIDEOIDLE $Snapshot; powercfg /setactive SCHEME_CURRENT }"
            ],
            "detect": [
              "$h = [regex]::Matches([string](powercfg /query SCHEME_CURRENT SUB_VIDEO VIDEOIDLE), '0x[0-9a-fA-F]{8}')",
              "$h.Count -ge 2 -and [Convert]::ToUInt32($h[$h.Count - 2].Value, 16) -eq 0"
            ]
          }
        },
        {
          "label": "5 minutes",
          "script": {
            "describe": "powercfg SUB_VIDEO VIDEOIDLE (plugged in) = 300 s",
            "snapshot": [
              "$h = [regex]::Matches([string](powercfg /query SCHEME_CURRENT SUB_VIDEO VIDEOIDLE), '0x[0-9a-fA-F]{8}')",
              "if ($h.Count -ge 2) { [string][Convert]::ToUInt32($h[$h.Count - 2].Value, 16) }"
            ],
            "apply": [
              "powercfg /setacvalueindex SCHEME_CURRENT SUB_VIDEO VIDEOIDLE 300",
              "powercfg /setactive SCHEME_CURRENT"
            ],
            "undo": [
              "if ($Snapshot) { powercfg /setacvalueindex SCHEME_CURRENT SUB_VIDEO VIDEOIDLE $Snapshot; powercfg /setactive SCHEME_CURRENT }"
            ],
            "detect": [
              "$h = [regex]::Matches([string](powercfg /query SCHEME_CURRENT SUB_VIDEO VIDEOIDLE), '0x[0-9a-fA-F]{8}')",
              "$h.Count -ge 2 -and [Convert]::ToUInt32($h[$h.Count - 2].Value, 16) -eq 300"
            ]
          }
        },
        {
          "label": "10 minutes",
          "script": {
