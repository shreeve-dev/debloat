      "name": "Sleep after",
      "category": "Power",
      "description": "When plugged in. Applies to the current power plan.",
      "options": [
        {
          "label": "Never",
          "script": {
            "describe": "powercfg SUB_SLEEP STANDBYIDLE (plugged in) = 0 s",
            "snapshot": [
              "$h = [regex]::Matches([string](powercfg /query SCHEME_CURRENT SUB_SLEEP STANDBYIDLE), '0x[0-9a-fA-F]{8}')",
              "if ($h.Count -ge 2) { [string][Convert]::ToUInt32($h[$h.Count - 2].Value, 16) }"
            ],
            "apply": [
              "powercfg /setacvalueindex SCHEME_CURRENT SUB_SLEEP STANDBYIDLE 0",
              "powercfg /setactive SCHEME_CURRENT"
            ],
            "undo": [
              "if ($Snapshot) { powercfg /setacvalueindex SCHEME_CURRENT SUB_SLEEP STANDBYIDLE $Snapshot; powercfg /setactive SCHEME_CURRENT }"
            ],
            "detect": [
              "$h = [regex]::Matches([string](powercfg /query SCHEME_CURRENT SUB_SLEEP STANDBYIDLE), '0x[0-9a-fA-F]{8}')",
              "$h.Count -ge 2 -and [Convert]::ToUInt32($h[$h.Count - 2].Value, 16) -eq 0"
