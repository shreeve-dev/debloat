            "snapshot": [
              "$h = [regex]::Matches([string](powercfg /query SCHEME_CURRENT SUB_VIDEO VIDEOIDLE), '0x[0-9a-fA-F]{8}')",
              "if ($h.Count -ge 2) { [string][Convert]::ToUInt32($h[$h.Count - 2].Value, 16) }"
            ],
            "apply": [
              "powercfg /setacvalueindex SCHEME_CURRENT SUB_VIDEO VIDEOIDLE 600",
              "powercfg /setactive SCHEME_CURRENT"
            ],
            "undo": [
              "if ($Snapshot) { powercfg /setacvalueindex SCHEME_CURRENT SUB_VIDEO VIDEOIDLE $Snapshot; powercfg /setactive SCHEME_CURRENT }"
            ],
            "detect": [
              "$h = [regex]::Matches([string](powercfg /query SCHEME_CURRENT SUB_VIDEO VIDEOIDLE), '0x[0-9a-fA-F]{8}')",
              "$h.Count -ge 2 -and [Convert]::ToUInt32($h[$h.Count - 2].Value, 16) -eq 600"
            ]
          }
        },
        {
