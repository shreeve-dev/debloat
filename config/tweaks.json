    {
      "id": "qol.numlock",
      "name": "Num Lock on at startup",
      "category": "Quality of Life",
      "risk": "safe",
      "description": "Num Lock is switched on when you sign in.",
      "after": ["signout"],
      "registry": [
        { "path": "HKCU\\Control Panel\\Keyboard", "name": "InitialKeyboardIndicators", "type": "String", "value": "2" }
      ]
    },
    {
      "id": "qol.menudelay",
      "name": "Snappier menus",
      "category": "Quality of Life",
      "risk": "safe",
      "description": "Cuts the delay before submenus open from 400 ms to 100 ms.",
      "after": ["signout"],
      "registry": [
        { "path": "HKCU\\Control Panel\\Desktop", "name": "MenuShowDelay", "type": "String", "value": "100" }
      ]
    },
    {
      "id": "qol.startupdelay",
      "name": "Remove the startup app delay",
      "category": "Quality of Life",
      "risk": "safe",
      "description": "Windows normally waits several seconds after sign-in before starting your startup apps. This removes that wait.",
      "registry": [
        { "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Serialize", "name": "StartupDelayInMSec", "type": "DWord", "value": 0 }
      ]
    },
    {
      "id": "qol.longpaths",
      "name": "Allow long file paths",
      "category": "Quality of Life",
      "risk": "safe",
      "description": "Lets apps that support it use paths longer than 260 characters. Handy for developers (node_modules, git).",
      "registry": [
        { "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\FileSystem", "name": "LongPathsEnabled", "type": "DWord", "value": 1 }
      ]
    },
    {
      "id": "qol.aeroshake",
      "name": "Turn off Aero Shake",
      "category": "Quality of Life",
      "risk": "safe",
      "description": "Shaking a window no longer minimises every other window.",
      "registry": [
        { "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "DisallowShaking", "type": "DWord", "value": 1 }
      ]
    },
    {
      "id": "qol.bsod",
      "name": "Show details on blue screens",
      "category": "Quality of Life",
      "risk": "safe",
      "description": "Blue screens show the technical error details, which makes crashes easier to diagnose.",
      "after": ["reboot"],
      "registry": [
        { "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\CrashControl", "name": "DisplayParameters", "type": "DWord", "value": 1 }
      ]
    },
    {
      "id": "qol.verbose",
      "name": "Detailed startup and shutdown messages",
      "category": "Quality of Life",
      "risk": "safe",
      "description": "Shows what Windows is doing (\"Stopping services...\") instead of just \"Please wait\".",
      "registry": [
        { "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "name": "VerboseStatus", "type": "DWord", "value": 1 }
      ]
    },
    {
      "id": "qol.settingshome",
      "name": "Hide the Settings Home page",
      "category": "Quality of Life",
      "risk": "safe",
      "description": "Settings opens on System instead of the Home page full of account and Microsoft 365 promos.",
      "registry": [
        { "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer", "name": "SettingsPageVisibility", "type": "String", "value": "hide:home" }
      ]
    },

    {
      "id": "perf.power",
      "name": "Ultimate Performance power plan",
      "category": "Performance",
      "risk": "moderate",
      "description": "Adds and activates the hidden Ultimate Performance plan, which stops the CPU from parking cores and saving power.",
      "note": "Desktops only - this drains laptop batteries much faster. Undo switches back to your previous plan.",
      "script": {
        "describe": "Create (if needed) and activate the Ultimate Performance power plan",
        "snapshot": "[regex]::Match([string](powercfg /getactivescheme), '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}').Value",
        "apply": [
          "$line = (powercfg /list | Select-String 'Ultimate Performance' | Select-Object -First 1).Line",
          "if (-not $line) { $line = [string](powercfg -duplicatescheme e9a42b02-d5df-448d-aa00-03f14749eb61) }",
          "$id = [regex]::Match([string]$line, '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}').Value",
          "if (-not $id) { throw 'Windows would not create the Ultimate Performance plan on this PC.' }",
          "powercfg /setactive $id | Out-Null"
        ],
        "undo": "if ($Snapshot) { powercfg /setactive $Snapshot | Out-Null }",
        "detect": "[string](powercfg /getactivescheme) -match 'Ultimate Performance'"
      }
    },
    {
      "id": "perf.hibernate",
      "name": "Turn off hibernation",
      "category": "Performance",
      "risk": "moderate",
      "description": "Deletes hiberfil.sys, which frees several GB of disk space (roughly 40% of your RAM size).",
      "note": "Also turns off Fast Startup and the Hibernate option. Laptops that rely on hibernate should skip this.",
      "script": {
        "describe": "powercfg /hibernate off",
        "snapshot": "[string](Get-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Power' -Name HibernateEnabled -ErrorAction SilentlyContinue).HibernateEnabled",
        "apply": "powercfg /hibernate off",
        "undo": "if ($Snapshot -eq '1') { powercfg /hibernate on }",
        "detect": "(Get-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Power' -Name HibernateEnabled -ErrorAction SilentlyContinue).HibernateEnabled -eq 0"
      }
    },
    {
      "id": "perf.animations",
      "name": "Reduce animations",
      "category": "Performance",
      "risk": "safe",
      "description": "Turns off window minimise/maximise and taskbar animations and Aero Peek, so windows appear instantly.",
      "after": ["signout"],
      "registry": [
        { "path": "HKCU\\Control Panel\\Desktop\\WindowMetrics", "name": "MinAnimate", "type": "String", "value": "0" },
        { "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "TaskbarAnimations", "type": "DWord", "value": 0 },
        { "path": "HKCU\\Software\\Microsoft\\Windows\\DWM", "name": "EnableAeroPeek", "type": "DWord", "value": 0 },
        { "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects", "name": "VisualFXSetting", "type": "DWord", "value": 3 }
      ]
    },
    {
      "id": "perf.bgapps",
      "name": "Stop Store apps running in the background",
      "category": "Performance",
      "risk": "moderate",
      "description": "Microsoft Store apps can only run while open. Saves a little RAM and battery.",
      "note": "Store apps (Mail, Phone Link, some chat apps) will not notify you while closed. Normal desktop apps are not affected.",
      "registry": [
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\AppPrivacy", "name": "LetAppsRunInBackground", "type": "DWord", "value": 2 }
      ]
    },
    {
      "id": "perf.services",
      "name": "Turn off rarely used services",
      "category": "Performance",
      "risk": "moderate",
      "description": "Disables Fax, Retail Demo, Remote Registry and the offline Maps downloader, and sets the WAP push service to manual.",
      "note": "Skip this if you use a fax modem or offline maps.",
      "services": [
        { "name": "Fax", "startup": "Disabled", "stop": true },
        { "name": "RetailDemo", "startup": "Disabled", "stop": true },
        { "name": "RemoteRegistry", "startup": "Disabled", "stop": true },
        { "name": "MapsBroker", "startup": "Disabled", "stop": true },
        { "name": "dmwappushservice", "startup": "Manual" }
      ]
    },
    {
      "id": "perf.sysmain",
      "name": "Turn off SysMain (Superfetch)",
      "category": "Performance",
      "risk": "advanced",
      "description": "Stops Windows preloading frequently used apps into RAM.",
      "note": "Usually makes no difference on SSDs and can make app launches slower. Only worth trying if you see constant disk use from SysMain.",
      "services": [
        { "name": "SysMain", "startup": "Disabled", "stop": true }
      ]
    },

    {
      "id": "gaming.gamemode",
      "name": "Turn on Game Mode",
      "category": "Gaming",
      "risk": "safe",
      "description": "Windows gives games priority and holds back Windows Update installs while you play.",
      "registry": [
        { "path": "HKCU\\Software\\Microsoft\\GameBar", "name": "AutoGameModeEnabled", "type": "DWord", "value": 1, "defaultMatches": true },
        { "path": "HKCU\\Software\\Microsoft\\GameBar", "name": "AllowAutoGameMode", "type": "DWord", "value": 1, "defaultMatches": true }
      ]
    },
    {
      "id": "gaming.gamedvr",
      "name": "Turn off background game recording",
      "category": "Gaming",
      "risk": "moderate",
      "description": "Stops Game Bar from constantly recording gameplay in the background, which can cost FPS.",
      "note": "The \"Record that\" (Win+Alt+G) clip feature stops working.",
      "registry": [
        { "path": "HKCU\\System\\GameConfigStore", "name": "GameDVR_Enabled", "type": "DWord", "value": 0 },
        { "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\GameDVR", "name": "AppCaptureEnabled", "type": "DWord", "value": 0 },
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\GameDVR", "name": "AllowGameDVR", "type": "DWord", "value": 0 }
      ]
    },
    {
      "id": "gaming.mouseaccel",
      "name": "Turn off mouse acceleration",
      "category": "Gaming",
      "risk": "safe",
      "description": "Turns off \"Enhance pointer precision\" so the cursor moves the same distance however fast you move the mouse. Preferred for aiming.",
      "after": ["signout"],
      "registry": [
        { "path": "HKCU\\Control Panel\\Mouse", "name": "MouseSpeed", "type": "String", "value": "0" },
        { "path": "HKCU\\Control Panel\\Mouse", "name": "MouseThreshold1", "type": "String", "value": "0" },
        { "path": "HKCU\\Control Panel\\Mouse", "name": "MouseThreshold2", "type": "String", "value": "0" }
      ]
    },
    {
      "id": "gaming.hags",
      "name": "Hardware-accelerated GPU scheduling",
      "category": "Gaming",
      "risk": "moderate",
      "description": "Lets the graphics card manage its own memory. Required for DLSS Frame Generation on NVIDIA cards.",
      "note": "Occasionally causes stutter on older GPUs or drivers - undo it if you notice problems.",
      "after": ["reboot"],
      "registry": [
        { "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\GraphicsDrivers", "name": "HwSchMode", "type": "DWord", "value": 2 }
      ]
    },
    {
      "id": "gaming.mmcss",
      "name": "Prioritise games and audio over background tasks",
      "category": "Gaming",
      "risk": "moderate",
      "description": "Removes Windows' network throttling during media playback and reserves less CPU for background tasks.",
      "note": "A popular tweak, but the gains are small and vary between PCs.",
      "after": ["reboot"],
      "registry": [
        { "path": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile", "name": "NetworkThrottlingIndex", "type": "DWord", "value": 4294967295 },
        { "path": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile", "name": "SystemResponsiveness", "type": "DWord", "value": 10 }
      ]
    },

    {
      "id": "wu.noautoreboot",
      "name": "No surprise restarts for updates",
      "category": "Windows Update",
      "risk": "safe",
      "description": "Windows will not restart automatically to finish updates while you are signed in.",
      "registry": [
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU", "name": "NoAutoRebootWithLoggedOnUsers", "type": "DWord", "value": 1 }
      ]
    },
    {
      "id": "wu.deliveryopt",
      "name": "Stop sharing updates with other PCs",
      "category": "Windows Update",
      "risk": "safe",
      "description": "Turns off peer-to-peer Delivery Optimization so your upload bandwidth is not used to send updates to other PCs.",
      "registry": [
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DeliveryOptimization", "name": "DODownloadMode", "type": "DWord", "value": 0 }
      ]
    },
    {
      "id": "wu.nodrivers",
      "name": "Don't install drivers through Windows Update",
      "category": "Windows Update",
      "risk": "moderate",
      "description": "Stops Windows Update replacing drivers you installed yourself (for example a newer GPU driver).",
      "note": "You become responsible for keeping drivers up to date.",
      "registry": [
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate", "name": "ExcludeWUDriversInQualityUpdate", "type": "DWord", "value": 1 }
      ]
    },
    {
      "id": "wu.deferfeature",
      "name": "Delay big feature updates by a year",
      "category": "Windows Update",
      "risk": "moderate",
      "description": "Security updates still install as normal. Big yearly feature updates (like 24H2 to 25H2) wait 365 days so the bugs get fixed first.",
      "note": "Works on Pro, Education and Enterprise only.",
      "registry": [
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate", "name": "DeferFeatureUpdates", "type": "DWord", "value": 1 },
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate", "name": "DeferFeatureUpdatesPeriodInDays", "type": "DWord", "value": 365 }
      ]
    },

    {
      "id": "vendor.devicemetadata",
      "name": "Stop hardware companion apps auto-installing",
      "category": "Vendor Bloat",
      "risk": "safe",
      "description": "Stops Windows downloading companion apps (Razer Synapse, Logitech, iCUE and similar) when you plug in a device. Drivers still install.",
      "registry": [
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\Device Metadata", "name": "PreventDeviceMetadataFromNetwork", "type": "DWord", "value": 1 },
        { "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Device Metadata", "name": "PreventDeviceMetadataFromNetwork", "type": "DWord", "value": 1 }
      ]
    },
    {
      "id": "vendor.wpbt",
      "name": "Block motherboard software auto-install (WPBT)",
      "category": "Vendor Bloat",
      "risk": "moderate",
      "description": "Stops your motherboard's firmware from pushing software such as ASUS Armoury Crate or MSI Center into Windows on every fresh install.",
      "note": "Turn the matching BIOS option off too. Software you installed yourself is not removed.",
      "after": ["reboot"],
      "registry": [
        { "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager", "name": "DisableWpbtExecution", "type": "DWord", "value": 1 }
      ]
    }
  ],

  "actions": [
    {
      "id": "action.restorepoint",
      "name": "Create a restore point",
      "description": "Saves a Windows System Restore point you can roll back to from Recovery options.",
      "script": [
        "$ok, $msg = New-SafetyRestorePoint",
        "$msg"
      ]
    },
    {
      "id": "action.temp",
      "name": "Clean temporary files",
      "description": "Deletes temporary files older than one day from your Temp folder and the Windows Temp folder. Files in use are skipped.",
      "script": [
        "$cutoff = (Get-Date).AddDays(-1); $count = 0; $bytes = 0",
        "foreach ($dir in @($env:TEMP, (Join-Path $env:WINDIR 'Temp'))) {",
        "  Get-ChildItem -LiteralPath $dir -Recurse -Force -File -ErrorAction SilentlyContinue | Where-Object { $_.LastWriteTime -lt $cutoff } | ForEach-Object {",
        "    $len = $_.Length",
        "    try { Remove-Item -LiteralPath $_.FullName -Force -ErrorAction Stop; $count++; $bytes += $len } catch { }",
        "  }",
        "}",
        "'Removed {0} files, freed {1:N0} MB.' -f $count, ($bytes / 1MB)"
      ]
    },
    {
      "id": "action.dns",
      "name": "Flush DNS cache",
      "description": "Clears cached DNS lookups. Useful when a website or a DNS change (like a Pi-hole rule) is not taking effect.",
      "script": [
        "Clear-DnsClientCache",
        "'DNS cache cleared.'"
      ]
    },
    {
      "id": "action.explorer",
      "name": "Restart File Explorer",
      "description": "Restarts the taskbar and File Explorer so taskbar and Explorer tweaks take effect.",
      "script": [
        "Restart-Explorer",
        "'File Explorer restarted.'"
      ]
    },
    {
      "id": "action.componentcleanup",
      "name": "Clean up old Windows Update files",
      "description": "Runs DISM component cleanup to delete superseded update files from WinSxS. Often frees several GB. Can take 5-15 minutes.",
      "external": true,
      "script": "Dism.exe /Online /Cleanup-Image /StartComponentCleanup"
    },
    {
      "id": "action.repair",
      "name": "Repair Windows system files",
      "description": "Runs DISM RestoreHealth and then SFC to find and fix corrupted system files. Can take 10-30 minutes.",
      "external": true,
      "script": [
        "Dism.exe /Online /Cleanup-Image /RestoreHealth",
        "sfc.exe /scannow"
      ]
    },
    {
      "id": "action.winget",
      "name": "Update all apps (winget)",
      "description": "Opens a window that updates every app winget can manage. You review and accept any prompts there.",
      "external": true,
      "script": "winget upgrade --all"
    }
  ]
}
