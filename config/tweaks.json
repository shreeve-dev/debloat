{
  "categories": [
    "Privacy",
    "AI & Copilot",
    "Ads & Suggestions",
    "Taskbar & Start",
    "File Explorer",
    "Quality of Life",
    "Performance",
    "Gaming",
    "Windows Update",
    "Vendor Bloat"
  ],
  "tweaks": [
    {
      "id": "privacy.telemetry",
      "name": "Reduce telemetry",
      "category": "Privacy",
      "risk": "safe",
      "description": "Sets diagnostic data to the lowest level your edition allows, turns off the Connected User Experiences service and the compatibility/CEIP data collection tasks.",
      "registry": [
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "type": "DWord", "value": 0 },
        { "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\DataCollection", "name": "AllowTelemetry", "type": "DWord", "value": 0 },
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "DoNotShowFeedbackNotifications", "type": "DWord", "value": 1 }
      ],
      "services": [
        { "name": "DiagTrack", "startup": "Disabled", "stop": true }
      ],
      "tasks": [
        { "path": "\\Microsoft\\Windows\\Application Experience\\", "name": "Microsoft Compatibility Appraiser", "state": "Disabled" },
        { "path": "\\Microsoft\\Windows\\Application Experience\\", "name": "ProgramDataUpdater", "state": "Disabled" },
        { "path": "\\Microsoft\\Windows\\Customer Experience Improvement Program\\", "name": "Consolidator", "state": "Disabled" },
        { "path": "\\Microsoft\\Windows\\Customer Experience Improvement Program\\", "name": "UsbCeip", "state": "Disabled" },
        { "path": "\\Microsoft\\Windows\\Autochk\\", "name": "Proxy", "state": "Disabled" }
      ]
    },
    {
      "id": "privacy.adid",
      "name": "Turn off advertising ID",
      "category": "Privacy",
      "risk": "safe",
      "description": "Stops apps from using a per-user advertising ID to show personalised ads.",
      "registry": [
        { "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo", "name": "Enabled", "type": "DWord", "value": 0 },
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\AdvertisingInfo", "name": "DisabledByGroupPolicy", "type": "DWord", "value": 1 }
      ]
    },
    {
      "id": "privacy.activity",
      "name": "Turn off activity history",
      "category": "Privacy",
      "risk": "safe",
      "description": "Stops Windows from recording and uploading the apps, files and sites you use.",
      "registry": [
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\System", "name": "EnableActivityFeed", "type": "DWord", "value": 0 },
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\System", "name": "PublishUserActivities", "type": "DWord", "value": 0 },
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\System", "name": "UploadUserActivities", "type": "DWord", "value": 0 }
      ]
    },
    {
      "id": "privacy.tailored",
      "name": "Turn off tailored experiences",
      "category": "Privacy",
      "risk": "safe",
      "description": "Stops Microsoft using your diagnostic data to personalise tips, ads and recommendations.",
      "registry": [
        { "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Privacy", "name": "TailoredExperiencesWithDiagnosticDataEnabled", "type": "DWord", "value": 0 }
      ]
    },
    {
      "id": "privacy.feedback",
      "name": "Stop feedback requests",
      "category": "Privacy",
      "risk": "safe",
      "description": "Stops the \"How likely are you to recommend Windows?\" style prompts.",
      "registry": [
        { "path": "HKCU\\Software\\Microsoft\\Siuf\\Rules", "name": "NumberOfSIUFInPeriod", "type": "DWord", "value": 0 }
      ],
      "tasks": [
        { "path": "\\Microsoft\\Windows\\Feedback\\Siuf\\", "name": "DmClient", "state": "Disabled" },
        { "path": "\\Microsoft\\Windows\\Feedback\\Siuf\\", "name": "DmClientOnScenarioDownload", "state": "Disabled" }
      ]
    },
    {
      "id": "privacy.inking",
      "name": "Turn off inking & typing personalisation",
      "category": "Privacy",
      "risk": "safe",
      "description": "Stops Windows collecting what you type and write to build a personal dictionary.",
      "registry": [
        { "path": "HKCU\\Software\\Microsoft\\InputPersonalization", "name": "RestrictImplicitInkCollection", "type": "DWord", "value": 1 },
        { "path": "HKCU\\Software\\Microsoft\\InputPersonalization", "name": "RestrictImplicitTextCollection", "type": "DWord", "value": 1 },
        { "path": "HKCU\\Software\\Microsoft\\InputPersonalization\\TrainedDataStore", "name": "HarvestContacts", "type": "DWord", "value": 0 },
        { "path": "HKCU\\Software\\Microsoft\\Personalization\\Settings", "name": "AcceptedPrivacyPolicy", "type": "DWord", "value": 0 }
      ]
    },
    {
      "id": "privacy.errorreporting",
      "name": "Turn off Windows Error Reporting",
      "category": "Privacy",
      "risk": "moderate",
      "description": "Stops crash reports being sent to Microsoft.",
      "note": "Microsoft will no longer get crash data that can lead to fixes for problems you hit.",
      "registry": [
        { "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\Windows Error Reporting", "name": "Disabled", "type": "DWord", "value": 1 }
      ],
      "tasks": [
        { "path": "\\Microsoft\\Windows\\Windows Error Reporting\\", "name": "QueueReporting", "state": "Disabled" }
      ]
    },
    {
      "id": "privacy.location",
      "name": "Turn off location for all apps",
      "category": "Privacy",
      "risk": "moderate",
      "description": "Blocks every app from reading your location.",
      "note": "Breaks Weather/Maps location, Find My Device and automatic time zone.",
      "registry": [
        { "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\CapabilityAccessManager\\ConsentStore\\location", "name": "Value", "type": "String", "value": "Deny" }
      ]
    },

    {
      "id": "ai.copilot",
      "name": "Turn off Windows Copilot",
      "category": "AI & Copilot",
      "risk": "safe",
      "description": "Turns off the built-in Copilot sidebar and hides its taskbar button. To remove the Copilot app itself, use the Apps page.",
      "after": ["explorer"],
      "registry": [
        { "path": "HKCU\\Software\\Policies\\Microsoft\\Windows\\WindowsCopilot", "name": "TurnOffWindowsCopilot", "type": "DWord", "value": 1 },
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsCopilot", "name": "TurnOffWindowsCopilot", "type": "DWord", "value": 1 },
        { "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "ShowCopilotButton", "type": "DWord", "value": 0 }
      ]
    },
    {
      "id": "ai.recall",
      "name": "Turn off Recall snapshots",
      "category": "AI & Copilot",
      "risk": "safe",
      "description": "Stops Recall from taking and analysing screenshots of your activity (Copilot+ PCs).",
      "registry": [
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI", "name": "DisableAIDataAnalysis", "type": "DWord", "value": 1 },
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI", "name": "AllowRecallEnablement", "type": "DWord", "value": 0 },
        { "path": "HKCU\\Software\\Policies\\Microsoft\\Windows\\WindowsAI", "name": "DisableAIDataAnalysis", "type": "DWord", "value": 1 }
      ]
    },
    {
      "id": "ai.clicktodo",
      "name": "Turn off Click to Do",
      "category": "AI & Copilot",
      "risk": "safe",
      "description": "Turns off the AI overlay that suggests actions for whatever is on screen.",
      "registry": [
        { "path": "HKCU\\Software\\Policies\\Microsoft\\Windows\\WindowsAI", "name": "DisableClickToDo", "type": "DWord", "value": 1 },
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI", "name": "DisableClickToDo", "type": "DWord", "value": 1 }
      ]
    },
    {
      "id": "ai.apps",
      "name": "Turn off AI features in Paint and Notepad",
      "category": "AI & Copilot",
      "risk": "safe",
      "description": "Hides Cocreator, generative fill and Image Creator in Paint, and Copilot rewrite in Notepad.",
      "registry": [
        { "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Paint", "name": "DisableCocreator", "type": "DWord", "value": 1 },
        { "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Paint", "name": "DisableGenerativeFill", "type": "DWord", "value": 1 },
        { "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Paint", "name": "DisableImageCreator", "type": "DWord", "value": 1 },
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\WindowsNotepad", "name": "DisableAIFeatures", "type": "DWord", "value": 1 }
      ]
    },

    {
      "id": "ads.autoinstall",
      "name": "Stop promoted apps installing themselves",
      "category": "Ads & Suggestions",
      "risk": "safe",
      "description": "Stops Windows silently installing promoted apps and games (the Candy Crush problem).",
      "registry": [
        { "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SilentInstalledAppsEnabled", "type": "DWord", "value": 0 },
        { "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "OemPreInstalledAppsEnabled", "type": "DWord", "value": 0 },
        { "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "PreInstalledAppsEnabled", "type": "DWord", "value": 0 },
        { "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "PreInstalledAppsEverEnabled", "type": "DWord", "value": 0 },
        { "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableWindowsConsumerFeatures", "type": "DWord", "value": 1 }
      ]
    },
    {
      "id": "ads.tips",
      "name": "Stop tips, tricks and \"finish setting up\" nags",
      "category": "Ads & Suggestions",
      "risk": "safe",
